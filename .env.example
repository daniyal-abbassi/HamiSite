# ==============================================================================
# HAMI HAMRAH — Host Deployment & Runtime Environment Variables
# ==============================================================================
# Copy this file to .env or .env.production on your host and supply the actual values.
# NEVER commit production secrets or actual credential values to source control.

# ------------------------------------------------------------------------------
# 1. CORE DATABASE (MANDATORY)
# ------------------------------------------------------------------------------
# PostgreSQL connection string used by Prisma ORM.
# Production recommendation: use connection pooler or pgBouncer if concurrency > 100.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hami_storefront?schema=public"

# ------------------------------------------------------------------------------
# 2. SERVER & HOST RUNTIME (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# Node runtime environment. Set to 'production' on your deployment host.
NODE_ENV=production

# Public canonical HTTPS origin in production. Used for payment callbacks, SEO, and absolute URLs.
APP_BASE_URL="https://hamihamrah.com"

# Host network binding.
# - Use '127.0.0.1' when running behind a local reverse proxy (Nginx / Caddy).
# - Use '0.0.0.0' only if listening directly on all network interfaces.
HOSTNAME="127.0.0.1"

# Internal HTTP listening port for the Node.js standalone process. Default is 3000.
PORT=3000

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY SECRETS (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# Cryptographic secret for signing session cookies and tokens (minimum 32 characters).
# Generate a secure key on Linux via: openssl rand -base64 32
NEXTAUTH_SECRET=

# Canonical URL for NextAuth callbacks (usually matches APP_BASE_URL).
NEXTAUTH_URL="https://hamihamrah.com"

# SMS.ir customer OTP login (server-only; use separate Sandbox/production keys)
# In Sandbox, use the test API key and Sandbox template ID supplied in SMS.ir.
# Production requires the production API key and an approved verification template.
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=
SMS_IR_CODE_PARAMETER=Code
# Generate separate values with at least 32 random bytes; never expose as NEXT_PUBLIC_*.
OTP_HASH_SECRET=
OTP_SOURCE_HASH_SECRET=
# Configure only when a trusted reverse proxy overwrites this header with the client IP.
# Without a trusted header, source throttling uses one shared fallback bucket.
OTP_TRUSTED_PROXY_HEADER=x-real-ip
OTP_SOURCE_REQUEST_LIMIT=20
OTP_SOURCE_WINDOW_SECONDS=600

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (ZARINPAL) — OPTIONAL FOR LOCAL DEV / MANDATORY FOR REAL SALES
# ------------------------------------------------------------------------------
# Zarinpal Merchant ID (UUID format).
# Leave unset to use the built-in mock payment gateway for testing and preview.
ZARINPAL_MERCHANT_ID=

# Set to true ONLY when using a Zarinpal sandbox merchant ID for staging tests.
# In production, must be false or unset (uses real api.zarinpal.com gateway).
ZARINPAL_SANDBOX=false

# ------------------------------------------------------------------------------
# 5. OPTIONAL INTEGRATIONS & SECOND OPINIONS
# ------------------------------------------------------------------------------
# Jev (NaraRouter System One) — second-opinion decision layer
JEV_API_KEY=
JEV_SYSTEMONE_URL=https://router.bynara.id/v1/systemone
JEV_MODEL=jev

# Telegram Admin Mini App & Push Notification Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
