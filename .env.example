# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mixin_ecommerce?schema=public"

# Public HTTPS origin in production, used to build payment callback URLs.
APP_BASE_URL="http://localhost:3000"

# Zarinpal merchant id. Leave unset to use the mock payment gateway (auto-succeeds
# for local dev/testing); set it to switch to the real Zarinpal integration with
# no route or flow changes.
ZARINPAL_MERCHANT_ID=
# Enable only with a sandbox merchant ID. Production uses api.zarinpal.com.
ZARINPAL_SANDBOX=false

# Jev (NaraRouter System One) — second-opinion decision layer
JEV_API_KEY=
JEV_SYSTEMONE_URL=https://router.bynara.id/v1/systemone
JEV_MODEL=jev

# Telegram Admin Mini App & Push Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
