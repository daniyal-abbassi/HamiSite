#!/usr/bin/env bash
# codex-ctl — talk to the Codex principal over the shared app-server daemon.
#
# Why this is not in worker-ctl: the other three workers are CLI agents inside tmux panes, so they are
# controlled by reading and writing a pane. Codex is a **principal** running in the owner's own terminal,
# attached to a daemon (`codex agents`, `codex queue`) that has no pane to inspect. Forcing it into the
# pane model would mean asking the owner to restart a session that holds their context. So the transport
# is different and the tool is separate.
#
# Verified against codex-cli 0.158.0 on 2026-09-29:
#   `codex queue --thread <uuid|name> --message <text>`  -> "Queued message <id> for thread <uuid>"
#   `codex agents`                                       -> ERROR: stdin is not a terminal (needs a TTY)
# so thread discovery reads ~/.codex/session_index.jsonl directly rather than shelling out to a picker.
#
# Usage:
#   tools/dispatch/codex-ctl status                 # newest threads, with age and a liveness hint
#   tools/dispatch/codex-ctl send <thread-id> --message-file <path>
#   tools/dispatch/codex-ctl last                   # print the most recently updated thread id

set -euo pipefail

CODEX="${CODEX_BIN:-/home/lain/.local/bin/codex}"
INDEX="${CODEX_SESSION_INDEX:-$HOME/.codex/session_index.jsonl}"

[ -x "$CODEX" ] || { echo "codex-ctl: no codex binary at $CODEX" >&2; exit 2; }
[ -f "$INDEX" ] || { echo "codex-ctl: no session index at $INDEX — codex has never written one here" >&2; exit 2; }

# A thread is treated as live if it was touched within this window. It is a heuristic and it is printed
# as one: the daemon exposes no non-interactive "is this session attached" answer.
LIVE_WINDOW_SECS="${CODEX_LIVE_WINDOW:-5400}"

newest_ids() {
  python3 - "$INDEX" "${1:-5}" <<'PY'
import json, sys, datetime
path, n = sys.argv[1], int(sys.argv[2])
rows = []
with open(path, encoding="utf-8") as fh:
    for line in fh:
        line = line.strip()
        if not line:
            continue
        try:
            r = json.loads(line)
        except json.JSONDecodeError:
            continue  # a torn final line is normal while the daemon is writing
        rows.append(r)
rows.sort(key=lambda r: r.get("updated_at", ""))
now = datetime.datetime.now(datetime.timezone.utc)
for r in rows[-n:][::-1]:
    upd = r.get("updated_at", "")
    try:
        # The daemon writes nanosecond fractions (…T20:23:03.831107857Z) and fromisoformat accepts at
        # most six digits, so every row used to fall through to "unknown" — which made this tool print
        # its headline column as a blank for every session.
        import re as _re
        norm = _re.sub(r"\.(\d{1,6})\d+", r".\1", upd)
        dt = datetime.datetime.fromisoformat(norm.replace("Z", "+00:00"))
        age = int((now - dt).total_seconds())
        live = "LIVE?" if age < int(__import__("os").environ.get("CODEX_LIVE_WINDOW", "5400")) else "idle"
    except Exception:
        age, live = -1, "unknown"
    print(f"{r.get('id','?')}  {live:<6} {age:>7}s ago  {str(r.get('thread_name',''))[:48]}")
PY
}

# Liveness is read from the process table, never inferred from the index timestamp: updated_at only
# moves when a turn is written, so a session sitting attached and thinking looks identical to one that
# was abandoned an hour ago. Which live process belongs to which thread is NOT observable from here,
# so the tool says how many are alive rather than pretending to map them.
live_procs() {
  # The interactive CLI appears in `ps` as a bare `codex` (launched from PATH), while the daemon and its
  # helpers appear with full paths and a subcommand. Matching on the path missed the one process that
  # mattered and reported "0 alive" next to a session that was demonstrably running.
  ps -eo pid=,etimes=,comm=,args= 2>/dev/null \
    | awk '$3=="codex" && $4 !~ /app-server|daemon|code-mode-host|remote-control/ {print $1" "$2}'
}

case "${1:-}" in
  status)
    n=$(live_procs | wc -l)
    echo "interactive codex processes alive: $n (thread→process mapping is not observable from the CLI)"
    live_procs | awk '{printf "  pid %s up %ss\n", $1, $2}'
    echo
    echo "threads by last written turn (a quiet thread is NOT a dead session):"
    newest_ids "${2:-8}"
    ;;
  last)
    newest_ids 1 | head -1 | awk '{print $1}'
    ;;
  send)
    shift
    THREAD="${1:-}"; [ -n "$THREAD" ] || { echo "codex-ctl: send needs a thread id" >&2; exit 2; }
    shift
    [ "${1:-}" = "--message-file" ] || { echo "codex-ctl: usage: codex-ctl send <thread> --message-file <path>" >&2; exit 2; }
    FILE="${2:-}"; [ -n "$FILE" ] && [ -f "$FILE" ] || { echo "codex-ctl: no such message file: $FILE" >&2; exit 2; }
    # Delivered as one argument, not interpolated into a shell string: a message containing $( ) or a
    # backtick must arrive as text rather than execute anywhere on its way.
    "$CODEX" queue --thread "$THREAD" --message "$(cat "$FILE")"
    ;;
  *)
    echo "usage: codex-ctl status [n] | last | send <thread-id> --message-file <path>" >&2
    exit 2
    ;;
esac
