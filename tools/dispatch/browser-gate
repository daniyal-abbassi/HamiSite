#!/usr/bin/env bash
# browser-gate — one agent at a time against the shared dev server on :3000.
#
# Why this exists: on 2026-09-28 two verification runs reported failures that were not the code's fault.
# A browser gate and a second agent's browsing shared one Next.js dev server, and the readings came back
# wrong — one harness crashed mid-navigation, another said "React never hydrated". Both refused to call
# that a pass, which is the correct behaviour, but a false failure still costs a full re-run and a
# re-audit of whatever was believed. A dev server compiling on demand is not a concurrency-safe resource.
#
# Usage:
#   tools/dispatch/browser-gate <who> -- node specs/.../measure-deck.mjs
#   tools/dispatch/browser-gate --status
#
# The lock is a real lock file under .agent-pair/locks/, created with noclobber so two agents racing for
# it cannot both win. On release it is MOVED to .agent-pair/released/, never deleted — the repo's rule.

set -u

LOCKS=.agent-pair/locks
RELEASED=.agent-pair/released
LOCK="$LOCKS/browser-3000.lock"
WAIT_SECS="${BROWSER_GATE_WAIT:-900}"   # 15 minutes of patience, then it is a human question
PORT="${DEV_PORT:-3000}"

mkdir -p "$LOCKS" "$RELEASED"

holder() { [ -f "$LOCK" ] && tr '\n' ' ' < "$LOCK"; }

acquire() {
  local who="$1" waited=0
  while true; do
    if ( set -o noclobber
         printf 'who: %s\nwhy: serialised browser verification against :%s\nsince: %s\npid: %s\n' \
           "$who" "$PORT" "$(date -Iseconds)" "$$" > "$LOCK" 2>/dev/null ); then
      return 0
    fi
    if [ "$waited" -ge "$WAIT_SECS" ]; then
      echo "browser-gate: still held after ${WAIT_SECS}s by [$(holder)] — NOT stealing it." >&2
      echo "browser-gate: a live agent may be measuring. Escalate to the human rather than overwrite." >&2
      return 75
    fi
    sleep 5
    waited=$((waited + 5))
  done
}

release() {
  # Only release what we created; a subshell that lost the race must not free someone else's lock.
  if [ -f "$LOCK" ] && grep -q "^pid: $$\$" "$LOCK" 2>/dev/null; then
    mv "$LOCK" "$RELEASED/browser-3000-$(date +%Y%m%dT%H%M%S)-$$-$(basename "$1").lock" 2>/dev/null || rm -f "$LOCK"
  fi
}

if [ "${1:-}" = "--status" ]; then
  if [ -f "$LOCK" ]; then echo "BUSY — $(holder)"; else echo "FREE"; fi
  exit 0
fi

if [ $# -lt 3 ] || [ "$2" != "--" ]; then
  echo "usage: browser-gate <who> -- <command...>" >&2
  exit 2
fi

WHO="$1"
shift 2

if ! acquire "$WHO"; then
  exit 75
fi

echo "browser-gate: $WHO holds :$PORT"
"$@"
CODE=$?
release "$WHO"
echo "browser-gate: released (exit $CODE)"
exit $CODE
