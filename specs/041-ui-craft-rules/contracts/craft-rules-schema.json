{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CraftAuditReport",
  "type": "object",
  "required": ["timestamp", "scanned_files_count", "violations", "passed", "summary"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "scanned_files_count": {
      "type": "integer",
      "minimum": 0
    },
    "passed": {
      "type": "boolean"
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "file_path", "line_number", "severity", "snippet", "suggested_fix"],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "file_path": {
            "type": "string"
          },
          "line_number": {
            "type": "integer",
            "minimum": 1
          },
          "severity": {
            "type": "string",
            "enum": ["error", "warning"]
          },
          "snippet": {
            "type": "string"
          },
          "suggested_fix": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["errors_count", "warnings_count"],
      "properties": {
        "errors_count": {
          "type": "integer",
          "minimum": 0
        },
        "warnings_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

