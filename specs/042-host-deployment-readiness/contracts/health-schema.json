{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HealthStatusReport",
  "type": "object",
  "required": [
    "status",
    "service",
    "version",
    "timestamp",
    "uptimeSeconds",
    "environment",
    "checks"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["healthy", "degraded", "unhealthy"]
    },
    "service": {
      "type": "string",
      "const": "hami-storefront-api"
    },
    "version": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "uptimeSeconds": {
      "type": "number",
      "minimum": 0
    },
    "environment": {
      "type": "string"
    },
    "checks": {
      "type": "object",
      "required": ["database", "memory"],
      "properties": {
        "database": {
          "type": "object",
          "required": ["status", "latencyMs"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["connected", "disconnected"]
            },
            "latencyMs": {
              "type": "number",
              "minimum": 0
            },
            "error": {
              "type": "string"
            }
          }
        },
        "memory": {
          "type": "object",
          "required": ["rssMb", "heapUsedMb", "heapTotalMb"],
          "properties": {
            "rssMb": {
              "type": "number"
            },
            "heapUsedMb": {
              "type": "number"
            },
            "heapTotalMb": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}

