{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chrome",
        "--headless"
      ]
    },
    "cloudflare-docs": {
      "type": "streamableHttp",
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    "graphify": {
      "command": "python3",
      "args": [
        "-m",
        "graphify.mcp",
        "/home/lain/lain_projects/hami-site-2/HamiSite-basic-structure/graphify-out/graph.json"
      ]
    },
    "codebase-memory-mcp": {
      "command": "/home/lain/.local/bin/codebase-memory-mcp"
    },
    "pixel-bridge": {
      "command": "/home/lain/.nvm/versions/node/v22.17.0/bin/node",
      "args": [
        "/home/lain/pixel-bridge-mcp/dist/index.js"
      ],
      "env": {
        "PIXEL_BRIDGE_BROWSER_CHANNEL": "chrome",
        "DISPLAY": ":0"
      }
    }
  }
}
